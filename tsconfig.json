{
  "compilerOptions": {
    "module": "ESNext",
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "outDir": "out",
    "rootDir": ".",
    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "bundler",
    "types": ["node", "vscode"]
  },
  "include": ["src", "test"]
}